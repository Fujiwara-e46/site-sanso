---
// Mentions légales (LCD art. 3 al. 1 let. s) — les coordonnées viennent de src/data/entreprise.json
import Base from '../layouts/Base.astro';
import e from '../data/entreprise.json';
---

<Base titre="Mentions légales">
  <section class="wrap legal">
    <h1>Mentions légales.</h1>
    <p>
      {e.raisonSociale}
      <br />
      {e.adresse}, {e.npa} {e.localite}
      <br />
      IDE : {e.ide}
      <br />
      <a href={`mailto:${e.email}`}>{e.email}</a>
      <br />
      {e.telephone}
    </p>
  </section>
</Base>
