---
// Mentions légales — les coordonnées viennent de src/data/entreprise.json
import Base from '../layouts/Base.astro';
import e from '../data/entreprise.json';
---

<Base titre="Mentions légales">
  <section class="wrap legal">
    <h1>Mentions légales.</h1>
    <h2>Éditeur du site</h2>
    <p>
      {e.raisonSociale}
      <br />
      {e.adresse}, {e.npa} {e.localite}
      <br />
      IDE : {e.ide}
      <br />
      {e.email}
      <br />
      {e.telephone}
    </p>
    <p>Responsable du contenu : {e.responsable}.</p>
    <h2>Hébergement</h2>
    <p>Ce site est hébergé en Suisse par Infomaniak Network SA, Rue Eugène-Marziano 25, 1227 Les Acacias (GE).</p>
    <h2>Contenus et illustrations</h2>
    <p>Les photographies et le logo sont fournis par SANSO CONCEPT.</p>
  </section>
</Base>
