---
// Déclaration de confidentialité (nLPD art. 19 : responsable, finalité, destinataires) — à faire valider par SANSO Concept
import Base from '../layouts/Base.astro';
import e from '../data/entreprise.json';
---

<Base titre="Politique de confidentialité">
  <section class="wrap legal">
    <h1>Politique de confidentialité.</h1>
    <p>
      Responsable : {e.raisonSociale}, {e.adresse}, {e.npa} {e.localite} — <a href={`mailto:${e.email}`}>{e.email}</a>.
    </p>
    <p>
      Les informations envoyées par le formulaire de contact (nom ou entreprise, e-mail, téléphone, type de besoin et
      message) servent uniquement à répondre à votre demande.
    </p>
    <p>
      Le site et la messagerie sont hébergés en Suisse par Infomaniak Network SA, qui transmet votre message à{' '}
      {e.raisonSociale}. Vos données ne sont ni vendues ni transmises à d’autres tiers.
    </p>
    <p>Le site n’utilise aucun cookie ni outil de mesure d’audience.</p>
    <p>
      Pour toute question sur vos données : <a href={`mailto:${e.email}`}>{e.email}</a>.
    </p>
  </section>
</Base>
